# Rendered into /etc/nginx/conf.d/default.conf by the nginx image's
# docker-entrypoint (envsubst of ${ENGINE_ORIGIN}).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Source videos and exports can be gigabytes; never reject an upload.
    client_max_body_size 0;

    # The renderer is a single page with no client-side router: if the file
    # exists it is the app's, everything else is an engine API call.
    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri @engine;
    }

    location @engine {
        proxy_pass ${ENGINE_ORIGIN};
        proxy_http_version 1.1;
        # WebSocket upgrade, for /ws.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Renders and uploads are long requests; do not cut them off.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Stream media and event responses instead of buffering them.
        proxy_buffering off;
    }
}
